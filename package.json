{
  "name": "front-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "test:browser": "node checks/browser.mjs",
    "test:voice": "node checks/gemini.mjs",
    "test:config": "node checks/config.mjs",
    "screenshots": "node checks/screenshots.mjs",
    "test:files": "node checks/files.mjs",
    "check": "node checks/syntax.mjs",
    "test:security": "node --test test/security.test.mjs test/file-tools.test.mjs && node checks/security.mjs",
    "test:all": "npm test && node checks/security.mjs && npm run test:files && npm run test:voice && npm run test:browser && npm run test:config",
    "test:phase2": "node --test test/indexing.test.mjs && node checks/files.mjs && node checks/security.mjs",
    "benchmark:index": "node checks/index-observation.mjs && node checks/index-benchmark.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "ajv": "^8.20.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonc-parser": "^3.3.1",
    "node-sqlite3-wasm": "0.8.61",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "description": "AI-powered voice appointment booking with Gemini Live, streaming audio and a configurable demo calendar",
  "repository": {
    "type": "git",
    "url": "https://github.com/Durga697/NewAgent.git"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
